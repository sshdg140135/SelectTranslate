<Window x:Class="SelectTranslate.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelectTranslate"
        Width="320"
        MinHeight="140"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="#F3F3F3"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8D8DE" />
            <Setter Property="Foreground" Value="#24242A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDEDF2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E2E9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#1B1B1F" />
            <Setter Property="CaretBrush" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Border x:Name="CardBorder"
            BorderBrush="#E1E1E6"
            BorderThickness="1"
            CornerRadius="10"
            Background="#F3F3F3"
            Padding="14"
            MouseLeftButtonDown="OnCardMouseLeftButtonDown">
        <StackPanel>
            <DockPanel x:Name="HeaderBar"
                       LastChildFill="False"
                       Background="Transparent">
                <TextBlock Text="SelectTranslate"
                           DockPanel.Dock="Left"
                           Foreground="#8A8A92"
                           FontSize="11" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Foreground="#8A8A92"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Button x:Name="PinButton"
                            Style="{StaticResource CardButton}"
                            Width="22"
                            Height="22"
                            Padding="0"
                            Margin="0,0,4,0"
                            FontSize="11"
                            ToolTip="钉住卡片"
                            Content="📌"
                            Click="OnPinClick" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CardButton}"
                            Width="22"
                            Height="22"
                            Padding="0"
                            Margin="0"
                            FontSize="11"
                            ToolTip="关闭"
                            Content="✕"
                            Click="OnCloseClick" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="OriginalText"
                       Foreground="#5F5F66"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MaxHeight="54"
                       TextTrimming="CharacterEllipsis"
                       LineHeight="17"
                       Margin="0,6,0,0" />

            <Border Height="1" Background="#E4E4E9" Margin="0,10,0,10" />

            <Grid x:Name="TranslationArea" MinHeight="52">
                <ScrollViewer x:Name="TranslationScroll"
                              MaxHeight="300"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="TranslationText"
                             IsReadOnly="True"
                             IsTabStop="False"
                             TextWrapping="Wrap"
                             FontSize="14"
                             MinHeight="22"
                             MouseDoubleClick="OnTranslationDoubleClick" />
                </ScrollViewer>

                <StackPanel x:Name="LoadingPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Grid x:Name="Spinner"
                          Width="14"
                          Height="14"
                          Margin="0,0,8,0"
                          Visibility="Collapsed"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                        </Grid.RenderTransform>
                        <Ellipse Stroke="#D5D5DE" StrokeThickness="2" />
                        <Path Data="M 7,1 A 6,6 0 0 1 13,7"
                              Stroke="#4F7DF3"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>
                    <TextBlock Text="翻译中…"
                               Foreground="#7A7A82"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="HintText"
                       Foreground="#7A7A82"
                       FontSize="12"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       Margin="0,8,0,0"
                       Visibility="Collapsed" />

            <StackPanel x:Name="Toolbar"
                        Orientation="Horizontal"
                        Margin="0,10,0,0">
                <Button x:Name="CopyButton"
                        Style="{StaticResource CardButton}"
                        Content="复制"
                        Click="OnCopyClick"
                        Visibility="Collapsed" />
                <Button x:Name="RetryButton"
                        Style="{StaticResource CardButton}"
                        Content="重试"
                        Click="OnRetryClick"
                        Visibility="Collapsed" />
                <Button x:Name="TranslateAnywayButton"
                        Style="{StaticResource CardButton}"
                        Content="仍要翻译"
                        Click="OnTranslateAnywayClick"
                        Visibility="Collapsed" />
                <Button x:Name="SettingsButton"
                        Style="{StaticResource CardButton}"
                        Content="去设置"
                        Click="OnSettingsClick"
                        Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>