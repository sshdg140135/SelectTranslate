<Window x:Class="SelectTranslate.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelectTranslate 设置"
        Width="560"
        Height="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        Background="#F7F7F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="设置"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#1B1B1F" />
            <TextBlock Text="最小配置页：接口、Key、模型、目标语言。完整五页设置与首次向导在 M3 补齐。"
                       FontSize="12"
                       Foreground="#6F6F77"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                <Border Background="White"
                        BorderBrush="#E3E3E7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="翻译服务" FontWeight="SemiBold" Foreground="#1B1B1F" />

                        <TextBlock Text="接口地址（OpenAI 兼容，填到 /v1 即可）"
                                   FontSize="12"
                                   Foreground="#4A4A52"
                                   Margin="0,14,0,4" />
                        <TextBox x:Name="BaseUrlBox" Height="30" Padding="6,4" VerticalContentAlignment="Center" />

                        <TextBlock Text="API Key（DPAPI 加密保存）"
                                   FontSize="12"
                                   Foreground="#4A4A52"
                                   Margin="0,12,0,4" />
                        <PasswordBox x:Name="ApiKeyBox" Height="30" Padding="6,4" VerticalContentAlignment="Center" />

                        <TextBlock Text="模型"
                                   FontSize="12"
                                   Foreground="#4A4A52"
                                   Margin="0,12,0,4" />
                        <TextBox x:Name="ModelBox" Height="30" Padding="6,4" VerticalContentAlignment="Center" />

                        <TextBlock Text="目标语言"
                                   FontSize="12"
                                   Foreground="#4A4A52"
                                   Margin="0,12,0,4" />
                        <ComboBox x:Name="TargetBox" Height="30" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="简体中文（zh-CN）" Tag="zh-CN" />
                            <ComboBoxItem Content="繁体中文（zh-TW）" Tag="zh-TW" />
                            <ComboBoxItem Content="英语（en）" Tag="en" />
                            <ComboBoxItem Content="日语（ja）" Tag="ja" />
                            <ComboBoxItem Content="韩语（ko）" Tag="ko" />
                            <ComboBoxItem Content="俄语（ru）" Tag="ru" />
                            <ComboBoxItem Content="阿拉伯语（ar）" Tag="ar" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#E3E3E7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="触发热键" FontWeight="SemiBold" Foreground="#1B1B1F" />
                        <TextBlock Text="鼠标中键始终可用；这里再加一个键盘组合（至少含一个 Ctrl/Alt/Shift/Win）。点输入框后直接按组合键。"
                                   FontSize="12"
                                   Foreground="#4A4A52"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HotkeyBox"
                                     Grid.Column="0"
                                     Height="30"
                                     Padding="6,4"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     PreviewKeyDown="OnHotkeyBoxKeyDown" />
                            <Button Grid.Column="1"
                                    Content="清除"
                                    Width="64"
                                    Height="30"
                                    Margin="8,0,0,0"
                                    Click="OnClearHotkeyClick" />
                        </Grid>

                        <TextBlock x:Name="HotkeyHint"
                                   FontSize="12"
                                   Foreground="#8A6D1F"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#E3E3E7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="运行信息" FontWeight="SemiBold" Foreground="#1B1B1F" />
                        <TextBlock x:Name="VersionText"
                                   FontSize="12"
                                   Foreground="#4A4A52"
                                   Margin="0,10,0,0" />
                        <TextBlock x:Name="ConfigPathText"
                                   FontSize="12"
                                   Foreground="#4A4A52"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LogPathText"
                                   FontSize="12"
                                   Foreground="#4A4A52"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="HotkeyText"
                                   FontSize="12"
                                   Foreground="#4A4A52"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#4A4A52"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="测试连接"
                        Width="96"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="OnTestClick" />
                <Button Content="保存"
                        Width="88"
                        Height="32"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Click="OnSaveClick" />
                <Button Content="关闭"
                        Width="88"
                        Height="32"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>